# Makefile.hdfs - HDFS/Spark Troubleshooting & Data Management
# Fixes data integrity issues, corrupt blocks, and HDFS recovery

# ============================================================================
# VARIABLES
# ============================================================================
NAMENODE := namenode
DATANODE := datanode
HDFS_PROJECT_DIR := /user/doanquochuy/uds-project
HDFS_DATA_DIR := $(HDFS_PROJECT_DIR)/data/raw

LOCAL_DATA_DIR := ./data/raw
WEATHER_FILE := hcmc_weather_raw.csv
ORDERS_FILE := uds_orders.csv

# ============================================================================
# PHONY TARGETS
# ============================================================================
.PHONY: help report check-fs reset-hdfs reload clean-cache safe-mode

# ============================================================================
# HELP TARGET
# ============================================================================
help:
	@echo "=========================================="
	@echo "HDFS Troubleshooting & Recovery Manager"
	@echo "=========================================="
	@echo ""
	@echo "DIAGNOSTICS:"
	@echo "  make report          - Show detailed HDFS filesystem report"
	@echo "  make check-fs        - Check filesystem integrity and find corrupt blocks"
	@echo ""
	@echo "DATA MANAGEMENT:"
	@echo "  make reset-hdfs      - Remove $(HDFS_PROJECT_DIR) and recreate folder structure"
	@echo "  make reload FILE=filename.csv - Reload a specific file from local to HDFS"
	@echo "  make clean-cache     - Clear HDFS namenode cache"
	@echo ""
	@echo "RECOVERY:"
	@echo "  make safe-mode       - Leave HDFS safe mode (if stuck)"
	@echo ""
	@echo "EXAMPLES:"
	@echo "  make -f Makefile.hdfs report"
	@echo "  make -f Makefile.hdfs check-fs"
	@echo "  make -f Makefile.hdfs reset-hdfs"
	@echo "  make -f Makefile.hdfs reload FILE=hcmc_weather_raw.csv"
	@echo ""

# ============================================================================
# DIAGNOSTIC TARGETS
# ============================================================================

# Display HDFS filesystem report (capacity, usage, datanodes)
report:
	@echo "📊 HDFS Filesystem Report"
	@echo "========================="
	@echo ""
	@echo "Cluster Status:"
	@echo "---------------"
	docker exec $(NAMENODE) hdfs dfsadmin -report
	@echo ""
	@echo "Datanode Status:"
	@echo "----------------"
	docker exec $(NAMENODE) hdfs dfsadmin -report | grep -A 30 "Datanodes"
	@echo ""
	@echo "Safe Mode Status:"
	@echo "-----------------"
	docker exec $(NAMENODE) hdfs dfsadmin -safemode get
	@echo ""

# Check filesystem integrity and identify corrupt blocks
check-fs:
	@echo "🔍 Checking HDFS Filesystem Integrity"
	@echo "====================================="
	@echo ""
	@echo "Full filesystem check (may take time):"
	@docker exec $(NAMENODE) hdfs fsck / -files -blocks -locations 2>&1 | tail -50
	@echo ""
	@echo "Project directory check:"
	@echo "------------------------"
	@docker exec $(NAMENODE) hdfs fsck $(HDFS_PROJECT_DIR) -files -blocks -locations 2>&1 || true
	@echo ""
	@echo "Corrupt blocks summary:"
	@echo "----------------------"
	@docker exec $(NAMENODE) hdfs fsck / 2>&1 | grep -i "corrupt\|missing" || echo "✓ No corrupt blocks found"
	@echo ""

# ============================================================================
# DATA MANAGEMENT TARGETS
# ============================================================================

# Reset HDFS project directory (delete and recreate)
reset-hdfs:
	@echo "⚠️  Resetting HDFS project directory..."
	@echo ""
	@echo "Step 1: Removing $(HDFS_PROJECT_DIR)..."
	@docker exec $(NAMENODE) hdfs dfs -rm -r $(HDFS_PROJECT_DIR) 2>/dev/null || \
		echo "  (Directory does not exist, continuing...)"
	@echo ""
	@echo "Step 2: Creating directory structure..."
	@docker exec $(NAMENODE) hdfs dfs -mkdir -p $(HDFS_DATA_DIR)
	@docker exec $(NAMENODE) hdfs dfs -ls -R $(HDFS_PROJECT_DIR)
	@echo ""
	@echo "✓ HDFS project directory reset complete"
	@echo ""
	@echo "Next steps:"
	@echo "  1. Upload data: make -f Makefile.hdfs reload FILE=hcmc_weather_raw.csv"
	@echo "  2. Upload data: make -f Makefile.hdfs reload FILE=uds_orders.csv"
	@echo ""

# Reload a specific file (delete from HDFS and re-upload from local)
reload:
	@if [ -z "$(FILE)" ]; then \
		echo "❌ Error: FILE parameter required"; \
		echo "Usage: make -f Makefile.hdfs reload FILE=hcmc_weather_raw.csv"; \
		echo "Available files:"; \
		ls -1 $(LOCAL_DATA_DIR)/; \
		exit 1; \
	fi
	@if [ ! -f "$(LOCAL_DATA_DIR)/$(FILE)" ]; then \
		echo "❌ Error: File not found: $(LOCAL_DATA_DIR)/$(FILE)"; \
		exit 1; \
	fi
	@echo "🔄 Reloading file: $(FILE)"
	@echo ""
	@echo "Step 1: Removing $(FILE) from HDFS..."
	@docker exec $(NAMENODE) hdfs dfs -rm $(HDFS_DATA_DIR)/$(FILE) 2>/dev/null || \
		echo "  (File does not exist, continuing...)"
	@echo ""
	@echo "Step 2: Copying $(FILE) to namenode..."
	@docker cp $(LOCAL_DATA_DIR)/$(FILE) $(NAMENODE):/tmp/
	@echo ""
	@echo "Step 3: Uploading $(FILE) to HDFS..."
	@docker exec $(NAMENODE) hdfs dfs -put /tmp/$(FILE) $(HDFS_DATA_DIR)/
	@echo ""
	@echo "Step 4: Verifying upload..."
	@docker exec $(NAMENODE) hdfs dfs -ls -h $(HDFS_DATA_DIR)/$(FILE)
	@echo ""
	@echo "✓ File reload complete: $(FILE)"
	@echo ""

# ============================================================================
# RECOVERY TARGETS
# ============================================================================

# Clear HDFS namenode cache and memory
clean-cache:
	@echo "🗑️  Clearing HDFS namenode cache..."
	@echo ""
	@echo "This operation clears internal namenode caches (not data)."
	@echo "Useful if experiencing memory leaks or stale metadata."
	@echo ""
	@docker exec $(NAMENODE) hdfs dfsadmin -saveNamespace
	@echo "✓ Namenode cache cleared and namespace saved"
	@echo ""

# Force HDFS out of safe mode
safe-mode:
	@echo "🔓 Forcing HDFS out of safe mode..."
	@echo ""
	@echo "Current safe mode status:"
	@docker exec $(NAMENODE) hdfs dfsadmin -safemode get
	@echo ""
	@docker exec $(NAMENODE) hdfs dfsadmin -safemode leave
	@echo ""
	@echo "New safe mode status:"
	@docker exec $(NAMENODE) hdfs dfsadmin -safemode get
	@echo "✓ Safe mode adjustment complete"
	@echo ""
